# AyunOS local configuration example.
# Copy to .env for local use. Do not put real keys in Git.

AYUNOS_DB_PATH=data/test/ayunos_memory_test.db
AYUNOS_REAL_DB_PATH=data/ayunos_chatgpt.db
AYUNOS_WEB_HOST=127.0.0.1
AYUNOS_WEB_PORT=8765

# Optional provider keys are not required by v2 local tools.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
